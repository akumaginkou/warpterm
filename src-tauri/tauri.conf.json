{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "warpterm",
  "version": "0.0.1",
  "identifier": "com.akumaginkou.warpterm",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix \"$(git rev-parse --show-toplevel)/frontend\" run dev",
    "beforeBuildCommand": "npm --prefix \"$(git rev-parse --show-toplevel)/frontend\" run build"
  },
  "app": {
    "windows": [
      {
        "title": "warpterm",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Terminal with Cloudflare WARP built in",
    "longDescription": "A terminal emulator whose shells egress through an embedded Cloudflare WARP (MASQUE) proxy, with live egress control.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["proxychains4"]
      }
    }
  }
}
